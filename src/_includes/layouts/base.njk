<!doctype html>
<html lang="{{ site.lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if isHome %}
  {%- set fullTitle = site.title + "｜" + site.tagline %}
  {%- else %}
  {%- set fullTitle = title + "｜" + site.title %}
  {%- endif %}
  <title>{{ fullTitle }}</title>
  {%- set metaDescription = (description or excerpt or site.description) | plainText(120) %}
  <meta name="description" content="{{ metaDescription }}">
  <meta name="theme-color" content="{% if world == 'lab' %}#070b18{% elif world == 'play' %}#ffd400{% else %}#e8392b{% endif %}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:type" content="{% if isPost %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  {%- if featured %}
  <meta property="og:image" content="{{ featured | absoluteUrl }}">
  {%- endif %}
  <link rel="icon" href="{{ '/assets/img/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@500;800&family=Noto+Sans+JP:wght@400;700&family=Zen+Kaku+Gothic+New:wght@300;500&display=swap">
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}">
</head>
<body class="world-{{ world or 'home' }}{% if bodyClass %} {{ bodyClass }}{% endif %}">
  <a class="skip-link" href="#main">本文へスキップ</a>
  <div class="world-bg" aria-hidden="true"></div>
  {% include "partials/header.njk" %}
  <main id="main" class="site-main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
</body>
</html>
